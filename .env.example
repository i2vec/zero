# Copy to `.env` and fill in real values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Upstream model (read by capgw; maps to endpoint / model / api_key)
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://your-model-endpoint/v1
LLM_PRO=your-model-name
LLM_API_KEY=sk-xxxx

# ---------------------------------------------------------------------------
# Bohrium / playground cloud sandbox (needed for ZERO_SANDBOX_BACKEND=lbg)
# ---------------------------------------------------------------------------
bohrium_key=xxxxxxxx
PLAYGROUND_KEY=xxxxxxxx
# Trisol authenticates non-interactively with this token when platform assets
# must be materialized in a sandbox. The CLI itself is installed automatically.
TRISOL_API_URL=https://trisol.dp.tech
TRISOL_TOKEN=your-trisol-personal-access-token
# Team id or name that owns/private-scopes Trisol assets. Public assets can be
# resolved without pinning a team when the authenticated identity may see them.
TRISOL_TEAM=2076600516862812160

# ---------------------------------------------------------------------------
# Optional zero settings (also readable from the real environment)
# ---------------------------------------------------------------------------
# System root: runs/, agent_skills/, experience/, tasks/ live under here.
# Default is this repo root. Point elsewhere if you keep those trees outside.
# ZERO_ROOT=/path/to/zero-system-root

ZERO_SANDBOX_BACKEND=auto
# Must be the Bohrium CLI variant that supports `lbg sdbx`, not legacy LBG 1.x.
# ZERO_LBG_BIN=/personal/conda_envs/paper2arm/bin/lbg
# Prefer an explicit internal registry URL so base-image startup does not depend on bohr discovery.
# ZERO_DOCKER_BASE_IMAGE=dp-harbor-registry.cn-zhangjiakou.cr.aliyuncs.com/public/paper2arm-env:v1.0-20260708
# Required to publish a reusable LBG image (rather than only a pip-freeze digest).
# ZERO_LBG_PROJECT_ID=your-project-id
# Sandbox auto-destroy lifetime in seconds (default 43200 = 12h; was 3h).
# ZERO_LBG_TIMEOUT=43200
# Seconds to wait at task completion for LBG imageUrl; set 0 to record only commit id.
# ZERO_LBG_IMAGE_WAIT_TIMEOUT=1800
# ZERO_TRISOL_INSTALL_URL=https://trisol.dp.tech/install.sh
# ZERO_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# ZERO_MODEL=claude-sonnet-4
# ZERO_CAPGW_PORT=8900
# ZERO_TRACE_UI_PORT=8901
# ZERO_TEACHER_ENABLED=1
# ZERO_TEACHER_MAX_ASKS=8

# Cross-run resource catalog (single reused connection; TLS verification stays on).
LITERATURE_SAGE_BASE_URL=https://literature-sage.test.bohrium.com
LITERATURE_SAGE_TIMEOUT_SEC=30
LITERATURE_SAGE_MAX_CONNECTIONS=1
LITERATURE_SAGE_MAX_RETRIES=4
# This host requires the Feilian HTTP CONNECT proxy for the test domain.
LITERATURE_SAGE_PROXY_URL=http://10.255.254.18:8118
# LITERATURE_SAGE_AUTH_TOKEN=
ZERO_RESOURCE_REGISTRY_ENABLED=1
ZERO_RESOURCE_PUBLISH_ENABLED=1
# ZERO_RESOURCE_RELEASE_STRICT=0

# Optional Tool miss builder.
DEPLOY_MASTER_BASE_URL=http://47.238.112.245:50001
DEPLOY_MASTER_POLL_INTERVAL_SEC=5
DEPLOY_MASTER_BUILD_DEADLINE_SEC=3600
# DEPLOY_MASTER_AUTH_TOKEN=
