# Copy to `.env` and fill in real values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Upstream model (read by capgw; maps to endpoint / model / api_key)
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://your-model-endpoint/v1
LLM_PRO=your-model-name
LLM_API_KEY=sk-xxxx

# ---------------------------------------------------------------------------
# Bohrium / playground cloud sandbox (needed for ZERO_SANDBOX_BACKEND=lbg)
# ---------------------------------------------------------------------------
bohrium_key=xxxxxxxx
PLAYGROUND_KEY=xxxxxxxx

# ---------------------------------------------------------------------------
# Optional zero settings (also readable from the real environment)
# ---------------------------------------------------------------------------
# System root: runs/, agent_skills/, experience/, tasks/ live under here.
# Default is this repo root. Point elsewhere if you keep those trees outside.
# ZERO_ROOT=/path/to/zero-system-root

ZERO_SANDBOX_BACKEND=auto
# Required to publish a reusable LBG image (rather than only a pip-freeze digest).
# ZERO_LBG_PROJECT_ID=your-project-id
# Sandbox auto-destroy lifetime in seconds (default 43200 = 12h; was 3h).
# ZERO_LBG_TIMEOUT=43200
# Seconds to wait at task completion for LBG imageUrl; set 0 to record only commit id.
# ZERO_LBG_IMAGE_WAIT_TIMEOUT=1800
# ZERO_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# ZERO_MODEL=claude-sonnet-4
# ZERO_CAPGW_PORT=8900
# ZERO_TRACE_UI_PORT=8901
# ZERO_TEACHER_ENABLED=1
# ZERO_TEACHER_MAX_ASKS=8
